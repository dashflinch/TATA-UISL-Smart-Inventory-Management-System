@model CompanyInventory.ViewModels.PaginatedList<CompanyInventory.Models.Ticket>

<div id="ticketNotification"></div>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">

            
        <div class="d-flex gap-2 flex-wrap">

            
            <form id="ticketFilterForm"
                  asp-action="PartialIndex"
                  asp-controller="Ticket"
                  method="get">

                <div class="row g-3">

                    <div class="col-md-2">
                        <label class="form-label">Ticket ID</label>
                        <input type="number"
                               name="ticketId"
                               value="@ViewBag.TicketId"
                               class="form-control"
                               placeholder="Ticket ID" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Created Date</label>
                        <input type="date"
                               name="createdDate"
                               value="@ViewBag.CreatedDate"
                               class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Category</label>
                        <select name="issueCategory" class="form-select">
                            <option value="">All</option>
                            <option value="Application">Application</option>
                            <option value="Network">Network</option>
                            <option value="Hardware">Hardware</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            <option value="">All</option>
                            <option>Open</option>
                            <option>Assigned</option>
                            <option>In Progress</option>
                            <option>Resolved</option>
                            <option>Closed</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Priority</label>
                        <select name="priority" class="form-select">
                            <option value="">All</option>
                            <option>Low</option>
                            <option>Medium</option>
                            <option>High</option>
                            <option>Critical</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Search</label>
                        <input type="text"
                               name="searchString"
                               value="@ViewData["CurrentFilter"]"
                               class="form-control"
                               placeholder="Title/System" />
                    </div>

                </div>

                <div class="mt-2 d-flex gap-2">

                    <button class="btn btn-primary">
                        <i class="fa-solid fa-filter"></i>
                        Filter
                    </button>

                    <button type="button"
                            id="resetTicketFilter"
                            class="btn btn-secondary">
                        Reset
                    </button>

                </div>

            </form>

            <div class="ms-3 mt-4">

                <button class="btn btn-primary btn-sm px-3 py-2"
                        data-bs-toggle="modal"
                        data-bs-target="#addTicketModal">
                    <i class="fa-solid fa-plus"></i>
                    Raise Ticket
                </button>

            </div>

        </div>

    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Ticket</th>
                    <th>Category</th>
                    <th>Issue Type</th>
                    <th>Affected System</th>
                    <th>Impact</th>
                    <th>Priority</th>

                    @if (User.IsInRole("Admin"))
                    {
                        <th>Status</th>
                        <th>Assigned To</th>
                    }

                    <th>Created By</th>

                    @if (User.IsInRole("Admin"))
                    {
                        <th>Actions</th>
                    }

                </tr>
            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            No tickets found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.TicketId</td>

                            <td>
                                <strong>@item.Title</strong>
                            </td>

                            <td>
                                @if (item.IssueCategory == "Application")
                                {
                                    <span class="badge bg-primary">
                                        <i class="fa-solid fa-laptop-code"></i>
                                        Application
                                    </span>
                                }
                                else if (item.IssueCategory == "Network")
                                {
                                    <span class="badge bg-info text-dark">
                                        <i class="fa-solid fa-network-wired"></i>
                                        Network
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="fa-solid fa-desktop"></i>
                                        Hardware
                                    </span>
                                }
                            </td>

                            <td>@item.IssueType</td>

                            <td>@item.AffectedSystem</td>

                            <td>@item.Impact</td>

                            <td>

                                @if (item.Priority == "Critical")
                                {
                                    <span class="badge bg-danger">Critical</span>
                                }
                                else if (item.Priority == "High")
                                {
                                    <span class="badge bg-warning text-dark">High</span>
                                }
                                else if (item.Priority == "Medium")
                                {
                                    <span class="badge bg-info">Medium</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Low</span>
                                }

                            </td>

                            @if (User.IsInRole("Admin"))
                            {
                                <td>
                                    @if (item.Status == "Open")
                                    {
                                        <span class="badge bg-primary">Open</span>
                                    }
                                    else if (item.Status == "In Progress")
                                    {
                                        <span class="badge bg-warning text-dark">In Progress</span>
                                    }
                                    else if (item.Status == "Resolved")
                                    {
                                        <span class="badge bg-success">Resolved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>

                                <td>@item.AssignedTo</td>
                            }

                            <td>@item.CreatedBy</td>

                            @if (User.IsInRole("Admin"))
                            {
                                <td class="text-center align-middle">

                                    <button class="btn btn-warning btn-sm editBtn"
                                            data-id="@item.TicketId"
                                            data-title="@item.Title"
                                            data-description="@item.Description"
                                            data-category="@item.IssueCategory"
                                            data-type="@item.IssueType"
                                            data-affected="@item.AffectedSystem"
                                            data-impact="@item.Impact"
                                            data-resolution="@item.ResolutionNotes"
                                            data-productid="@item.ProductId"
                                            data-priority="@item.Priority"
                                            data-status="@item.Status"
                                            data-assigned="@item.AssignedTo"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editTicketModal">

                                        <i class="fa-solid fa-pen"></i>

                                    </button>

                                </td>
                            }

                            @* <form asp-action="Delete"
                                  asp-route-id="@item.TicketId"
                                  method="post"
                                  class="d-inline">

                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Delete this ticket?')">
                                    Delete
                                </button>

                            </form> *@

                       

                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>
    <nav class="mt-3">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                @* <a class="page-link"
               asp-action="Index"
               asp-route-page="@(Model.PageIndex - 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]">
                Previous
            </a> *@
                <a class="page-link  ticket-page-link"
                   asp-action="PartialIndex"
                   asp-controller="Ticket"
                   asp-route-page="@(Model.PageIndex - 1)"
                   asp-route-searchString="@ViewData["CurrentFilter"]"
                   asp-route-ticketId="@ViewBag.TicketId"
                   asp-route-createdDate="@ViewBag.CreatedDate"
                   asp-route-issueCategory="@ViewBag.IssueCategory"
                   asp-route-status="@ViewBag.Status"
                   asp-route-priority="@ViewBag.Priority">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    @* <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-searchString="@ViewData["CurrentFilter"]">
                    @i
                </a> *@
                    <a class="page-link  ticket-page-link"
                       asp-action="PartialIndex"
                       asp-controller="Ticket"
                       asp-route-page="@i"
                       asp-route-searchString="@ViewData["CurrentFilter"]"
                       asp-route-ticketId="@ViewBag.TicketId"
                       asp-route-createdDate="@ViewBag.CreatedDate"
                       asp-route-issueCategory="@ViewBag.IssueCategory"
                       asp-route-status="@ViewBag.Status"
                       asp-route-priority="@ViewBag.Priority">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                @* <a class="page-link"
               asp-action="Index"
               asp-route-page="@(Model.PageIndex + 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]">
                Next
            </a> *@
                <a class="page-link  ticket-page-link"
                   asp-action="PartialIndex"
                   asp-controller="Ticket"
                   asp-route-page="@(Model.PageIndex + 1)"
                   asp-route-searchString="@ViewData["CurrentFilter"]"
                   asp-route-ticketId="@ViewBag.TicketId"
                   asp-route-createdDate="@ViewBag.CreatedDate"
                   asp-route-issueCategory="@ViewBag.IssueCategory"
                   asp-route-status="@ViewBag.Status"
                   asp-route-priority="@ViewBag.Priority">
                    Next
                </a>
            </li>

        </ul>
    </nav>

</div>


<!-- Add Ticket Modal -->

<div class="modal fade"
     id="addTicketModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            @* <form asp-action="Create" method="post"> *@
            <form id="createTicketForm" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">

                    <h5 class="modal-title">
                        <i class="fa-solid fa-ticket"></i>
                        Raise Ticket
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input name="Title" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description"
                                  rows="4"
                                  class="form-control"
                                  required></textarea>
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Issue Category</label>

                            <select name="IssueCategory"
                                    id="issueCategory"
                                    class="form-select"
                                    required>

                                <option value="">-- Select Category --</option>
                                <option value="Application">Application</option>
                                <option value="Network">Network</option>
                                <option value="Hardware">Hardware</option>

                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Issue Type</label>

                            <select name="IssueType"
                                    id="issueType"
                                    class="form-select"
                                    required>

                                <option value="">Select Category First</option>

                            </select>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">Affected System</label>

                            <input name="AffectedSystem"
                                   class="form-control"
                                   placeholder="Server / App / IP / Device"
                                   required />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">Impact</label>

                            <select name="Impact"
                                    class="form-select"
                                    required>

                                <option value="">Select Impact</option>
                                <option>Single User</option>
                                <option>Department</option>
                                <option>Organization</option>

                            </select>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Product</label>

                        <select name="ProductId"
                                class="form-select">

                            <option value="">-- Select Product --</option>

                            @foreach (var product in ViewBag.Products)
                            {
                                <option value="@product.Value">
                                    @product.Text
                                </option>
                            }

                        </select>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">Priority</label>

                            <select name="Priority"
                                    class="form-select"
                                    required>

                                <option value="">-- Select Priority --</option>
                                <option>Low</option>
                                <option>Medium</option>
                                <option>High</option>
                                <option>Critical</option>

                            </select>

                        </div>
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="col-md-6 mb-3">

                                <label class="form-label">Status</label>

                                <select name="Status"
                                        class="form-select">

                                    <option>Open</option>
                                    <option>Assigned</option>
                                    <option>In Progress</option>
                                    <option>Resolved</option>
                                    <option>Closed</option>

                                </select>

                            </div>
                        }

                    </div>
                    @if (User.IsInRole("Admin"))
                    {

                        <div class="mb-3">

                            <label class="form-label">Assigned To</label>

                            <input name="AssignedTo"
                                   class="form-control"
                                   placeholder="Optional" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Resolution Notes
                            </label>

                            <textarea name="ResolutionNotes"
                                      rows="3"
                                      class="form-control"></textarea>

                        </div>
                    }

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Save
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>





<!-- Edit Ticket Modal -->
@if (User.IsInRole("Admin"))
{
    <div class="modal fade"
         id="editTicketModal"
         tabindex="-1">

        <div class="modal-dialog modal-lg">

            <div class="modal-content">

                @* <form asp-action="Edit" method="post"> *@
                <form id="editTicketForm"
                      asp-controller="Ticket"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-header bg-warning">

                        <h5 class="modal-title">
                            <i class="fa-solid fa-pen"></i>
                            Edit Ticket
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               id="editTicketId"
                               name="TicketId" />

                        <div class="mb-3">

                            <label class="form-label">Title</label>

                            <input id="editTitle"
                                   name="Title"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">Description</label>

                            <textarea id="editDescription"
                                      name="Description"
                                      rows="4"
                                      class="form-control"
                                      required></textarea>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label">Issue Category</label>

                                <select id="editIssueCategory"
                                        name="IssueCategory"
                                        class="form-select"
                                        required>

                                    <option value="Application">Application</option>
                                    <option value="Network">Network</option>
                                    <option value="Hardware">Hardware</option>

                                </select>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label">Issue Type</label>

                                <select id="editIssueType"
                                        name="IssueType"
                                        class="form-select"
                                        required>
                                </select>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label">Affected System</label>

                                <input id="editAffectedSystem"
                                       name="AffectedSystem"
                                       class="form-control"
                                       required />

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label">Impact</label>

                                <select id="editImpact"
                                        name="Impact"
                                        class="form-select"
                                        required>

                                    <option>Single User</option>
                                    <option>Department</option>
                                    <option>Organization</option>

                                </select>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">Product</label>

                            <select id="editProductId"
                                    name="ProductId"
                                    class="form-select">

                                @foreach (var product in ViewBag.Products)
                                {
                                    <option value="@product.Value">
                                        @product.Text
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label">Priority</label>

                                <select id="editPriority"
                                        name="Priority"
                                        class="form-select">

                                    <option>Low</option>
                                    <option>Medium</option>
                                    <option>High</option>
                                    <option>Critical</option>

                                </select>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label class="form-label">Status</label>

                                <select id="editStatus"
                                        name="Status"
                                        class="form-select">

                                    <option>Open</option>
                                    <option>Assigned</option>
                                    <option>In Progress</option>
                                    <option>Resolved</option>
                                    <option>Closed</option>

                                </select>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">Assigned To</label>

                            <input id="editAssignedTo"
                                   name="AssignedTo"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Resolution Notes
                            </label>

                            <textarea id="editResolutionNotes"
                                      name="ResolutionNotes"
                                      rows="3"
                                      class="form-control"></textarea>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-warning">
                            Update
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}


