<script>

    (function () {

        const issueTypes = {
            Application: [
                "Software Bug",
                "System Crash",
                "Performance",
                "Login Issue",
                "Database Issue"
            ],
            Network: [
                "Connectivity",
                "VPN",
                "Wi-Fi / LAN",
                "Firewall",
                "DNS / IP"
            ],
            Hardware: [
                "Laptop",
                "Desktop",
                "Printer",
                "Monitor",
                "Router"
            ]
        };


        // ==========================================
        // LOAD ISSUE TYPES
        // ==========================================

        function loadIssueTypes(categoryId, typeId, selectedType = "") {

            const category = document.getElementById(categoryId);
            const type = document.getElementById(typeId);

            if (!category || !type) return;

            const selectedCategory = category.value;

            type.innerHTML =
                '<option value="">-- Select Issue Type --</option>';

            if (!issueTypes[selectedCategory]) return;

            issueTypes[selectedCategory].forEach(function (item) {

                const option = document.createElement("option");

                option.value = item;
                option.text = item;

                if (item === selectedType) {
                    option.selected = true;
                }

                type.appendChild(option);
            });
        }


        // ==========================================
        // CREATE TICKET CATEGORY CHANGE
        // ==========================================

        $(document)
            .off("change.ticketCreate", "#issueCategory")
            .on("change.ticketCreate", "#issueCategory", function () {

                loadIssueTypes("issueCategory", "issueType");

            });


        // ==========================================
        // EDIT TICKET CATEGORY CHANGE
        // ==========================================

        $(document)
            .off("change.ticketEdit", "#editIssueCategory")
            .on("change.ticketEdit", "#editIssueCategory", function () {

                loadIssueTypes(
                    "editIssueCategory",
                    "editIssueType"
                );

            });


        // ==========================================
        // OPEN EDIT MODAL
        // ==========================================

        $(document)
            .off("click.ticketEdit", ".editBtn")
            .on("click.ticketEdit", ".editBtn", function () {

                const button = this;

                $("#editTicketId").val(button.dataset.id);
                $("#editTitle").val(button.dataset.title);
                $("#editDescription").val(button.dataset.description);

                $("#editIssueCategory").val(button.dataset.category);

                loadIssueTypes(
                    "editIssueCategory",
                    "editIssueType",
                    button.dataset.type
                );

                $("#editAffectedSystem").val(button.dataset.affected);
                $("#editImpact").val(button.dataset.impact);
                $("#editResolutionNotes").val(button.dataset.resolution);
                $("#editProductId").val(button.dataset.productid);
                $("#editPriority").val(button.dataset.priority);
                $("#editStatus").val(button.dataset.status);
                $("#editAssignedTo").val(button.dataset.assigned);

            });


        // ==========================================
        // CREATE TICKET AJAX
        // ==========================================

        $(document)
            .off("submit.ticketCreate", "#createTicketForm")
            .on("submit.ticketCreate", "#createTicketForm", function (e) {

                e.preventDefault();

                const form = $(this);

                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: form.serialize(),

                    success: function (response) {

                        if (response.success) {

                            const modalElement =
                                document.getElementById("addTicketModal");

                            const modal =
                                bootstrap.Modal.getInstance(modalElement);

                            if (modal) {
                                modal.hide();
                            }

                            form[0].reset();

                            $("#dashboardContent").load(
                                "/Ticket/PartialIndex",
                                function () {

                                    $("#ticketNotification").html(`
                                        <div class="alert alert-success ticketSuccessMessage">
                                            ${response.message}
                                        </div>
                                    `);

                                    setTimeout(function () {

                                        $(".ticketSuccessMessage")
                                            .fadeOut(1000, function () {
                                                $(this).remove();
                                            });

                                    }, 3000);

                                }
                            );

                        } else {

                            alert(response.message);

                        }

                    },

                    error: function () {

                        alert(
                            "Something went wrong while creating the ticket."
                        );

                    }

                });

            });


        // ==========================================
        // EDIT TICKET AJAX
        // ==========================================

        $(document)
            .off("submit.ticketEdit", "#editTicketForm")
            .on("submit.ticketEdit", "#editTicketForm", function (e) {

                e.preventDefault();

                const form = $(this);

                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: form.serialize(),

                    success: function (response) {

                        if (response.success) {

                            const modalElement =
                                document.getElementById("editTicketModal");

                            const modal =
                                bootstrap.Modal.getInstance(modalElement);

                            if (modal) {
                                modal.hide();
                            }

                            $("#dashboardContent").load(
                                "/Ticket/PartialIndex"
                            );

                        } else {

                            alert(response.message);

                        }

                    },

                    error: function () {

                        alert(
                            "Something went wrong while updating the ticket."
                        );

                    }

                });

            });


        // ==========================================
        // TICKET FILTER AJAX
        // ==========================================

        $(document)
            .off("submit.ticketFilter", "#ticketFilterForm")
            .on("submit.ticketFilter", "#ticketFilterForm", function (e) {

                e.preventDefault();

                const url =
                    $(this).attr("action") +
                    "?" +
                    $(this).serialize();

                $("#dashboardContent").load(url);

            });


        // ==========================================
        // RESET TICKET FILTER
        // ==========================================

        $(document)
            .off("click.ticketReset", "#resetTicketFilter")
            .on("click.ticketReset", "#resetTicketFilter", function () {

                $("#dashboardContent").load(
                    "/Ticket/PartialIndex"
                );

            });


        // ==========================================
        // TICKET PAGINATION AJAX
        // ==========================================

        $(document)
            .off("click.ticketPage", ".ticket-page-link")
            .on("click.ticketPage", ".ticket-page-link", function (e) {

                e.preventDefault();

                if ($(this).parent().hasClass("disabled")) {
                    return;
                }

                $("#dashboardContent").load(
                    $(this).attr("href")
                );

            });

    })();
</script>