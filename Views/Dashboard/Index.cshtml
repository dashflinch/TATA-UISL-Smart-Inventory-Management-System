@model CompanyInventory.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";
    ViewData["Subtitle"] = "Track and manage maintenance tickets";
}


        <!-- Cards -->
        <div class="card-container">

            <div class="dashboard-card green module-card"
                 data-module="product"
                 style="cursor:pointer;">

                <i class="fa-solid fa-box"></i>

                <div>
                    <h5>Products</h5>
                    <h2>@Model.TotalProducts</h2>
                    <small>View Products →</small>
                </div>

            </div>

            <div class="dashboard-card blue module-card"
                 data-module="category"     
                 style="cursor:pointer;">

                <i class="fa-solid fa-layer-group"></i>

                <div>
                    <h5>Categories</h5>
                    <h2>@Model.TotalCategories</h2>
                    <small>View Categories →</small>
                </div>

            </div>

            <div class="dashboard-card orange module-card"
                 data-module="ticket"
                 style="cursor:pointer;">

                <i class="fa-solid fa-ticket"></i>

                <div>
                    <h5>Tickets</h5>
                    <h2>@Model.TotalTickets</h2>
                    <small>View Tickets →</small>
                </div>

            </div>

            <div class="dashboard-card red"
                 id="fourthTile">

                <i id="fourthTileIcon"
                   class="fa-solid @Model.FourthTileIcon"></i>

                <div>

                    <h5 id="fourthTileTitle">
                        @Model.FourthTileTitle
                    </h5>

                    <h2 id="fourthTileCount">
                        @Model.FourthTileCount
                    </h2>

                    <small id="fourthTileText">
                        Dynamic Information
                    </small>

                </div>

            </div>

        </div>


