@model CompanyInventory.ViewModels.PaginatedList<CompanyInventory.Models.Category>

<div class="container-fluid mt-4">

    <!-- =========================
         FILTER SECTION
    ========================== -->

    <div class="d-flex justify-content-between align-items-end flex-wrap mb-4">

        <form id="categoryFilterForm"
              asp-action="PartialIndex"
              asp-controller="Category"
              method="get"
              class="row g-2 flex-grow-1">

            <!-- Search -->
            <div class="col-md-5">

                <label class="form-label">Search</label>

                <input type="text"
                       name="searchString"
                       value="@ViewData["CurrentFilter"]"
                       class="form-control"
                       placeholder="Search Category..." />

            </div>


            <!-- Buttons -->
            <div class="col-md-4 d-flex align-items-end gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fa-solid fa-filter"></i>
                    Filter

                </button>


                <button type="button"
                        id="resetCategoryFilter"
                        class="btn btn-secondary">

                    <i class="fa-solid fa-rotate-left"></i>
                    Reset

                </button>

            </div>

        </form>


        <!-- Add Category -->
        <button type="button"
                class="btn btn-primary ms-3"
                data-bs-toggle="modal"
                data-bs-target="#createCategoryModal">

            <i class="fa-solid fa-plus"></i>

            Add Category

        </button>

    </div>


    <!-- =========================
         SUCCESS MESSAGE
    ========================== -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success categorySuccessMessage">
            @TempData["Success"]
        </div>
    }


    <!-- =========================
         CATEGORY TABLE
    ========================== -->

    <div class="card shadow border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-primary">

                        <tr>

                            <th>ID</th>

                            <th>Category Name</th>

                            <th>Description</th>

                            <th>Status</th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.CategoryId
                                    </td>


                                    <td>
                                        @item.CategoryName
                                    </td>


                                    <td>
                                        @item.Description
                                    </td>


                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }

                                    </td>


                                    <td class="text-center">

                                        <!-- EDIT -->

                                        <button type="button"
                                                class="btn btn-warning btn-sm editCategoryBtn"
                                                data-id="@item.CategoryId"
                                                data-name="@item.CategoryName"
                                                data-description="@item.Description"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editCategoryModal">

                                            <i class="fa-solid fa-pen"></i>

                                        </button>


                                        <!-- DELETE -->

                                        <form class="deleteCategoryForm d-inline"
                                              asp-action="Delete"
                                              asp-controller="Category"
                                              asp-route-id="@item.CategoryId"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5"
                                    class="text-center text-muted">

                                    No categories available.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- =========================
                 PAGINATION
            ========================== -->

            <nav class="mt-3">

                <ul class="pagination justify-content-center">


                    <!-- PREVIOUS -->

                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">

                        <a class="page-link"
                           asp-action="PartialIndex"
                           asp-controller="Category"
                           asp-route-page="@(Model.PageIndex - 1)"
                           asp-route-searchString="@ViewData["CurrentFilter"]">

                            Previous

                        </a>

                    </li>


                    <!-- PAGE NUMBERS -->

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageIndex ? "active" : "")">

                            <a class="page-link"
                               asp-action="PartialIndex"
                               asp-controller="Category"
                               asp-route-page="@i"
                               asp-route-searchString="@ViewData["CurrentFilter"]">

                                @i

                            </a>

                        </li>
                    }


                    <!-- NEXT -->

                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">

                        <a class="page-link"
                           asp-action="PartialIndex"
                           asp-controller="Category"
                           asp-route-page="@(Model.PageIndex + 1)"
                           asp-route-searchString="@ViewData["CurrentFilter"]">

                            Next

                        </a>

                    </li>

                </ul>

            </nav>

        </div>

    </div>

</div>



<!-- ==================================================
     ADD CATEGORY MODAL
=================================================== -->

<div class="modal fade"
     id="createCategoryModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form id="createCategoryForm"
                  asp-action="Create"
                  asp-controller="Category"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="modal-header bg-primary text-white">

                    <h5 class="modal-title">

                        <i class="fa-solid fa-plus"></i>

                        Add Category

                    </h5>


                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            Category Name
                        </label>

                        <input type="text"
                               name="CategoryName"
                               class="form-control"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Description
                        </label>

                        <textarea name="Description"
                                  rows="4"
                                  class="form-control"></textarea>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-floppy-disk"></i>

                        Save

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- ==================================================
     EDIT CATEGORY MODAL
=================================================== -->

<div class="modal fade"
     id="editCategoryModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form id="editCategoryForm"
                  asp-action="Edit"
                  asp-controller="Category"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="modal-header bg-warning">

                    <h5 class="modal-title">

                        <i class="fa-solid fa-pen"></i>

                        Edit Category

                    </h5>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <input type="hidden"
                           id="editCategoryId"
                           name="CategoryId" />


                    <div class="mb-3">

                        <label class="form-label">
                            Category Name
                        </label>

                        <input id="editCategoryName"
                               name="CategoryName"
                               class="form-control"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Description
                        </label>

                        <textarea id="editCategoryDescription"
                                  name="Description"
                                  rows="4"
                                  class="form-control"></textarea>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-warning">

                        Update

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- ==================================================
     JAVASCRIPT
=================================================== -->

<script>

    // ==========================================
    // EDIT CATEGORY MODAL
    // ==========================================

    $(document).off("click", ".editCategoryBtn");

    $(document).on("click", ".editCategoryBtn", function () {

        $("#editCategoryId").val($(this).data("id"));

        $("#editCategoryName").val($(this).data("name"));

        $("#editCategoryDescription").val(
            $(this).data("description")
        );

    });


    // ==========================================
    // CATEGORY FILTER
    // ==========================================

    $(document).off("submit", "#categoryFilterForm");

    $(document).on("submit", "#categoryFilterForm", function (e) {

        e.preventDefault();

        var url =
            $(this).attr("action")
            + "?"
            + $(this).serialize();

        $("#dashboardContent").load(url);

    });


    // ==========================================
    // PAGINATION
    // ==========================================

    $(document).off("click", ".pagination a");

    $(document).on("click", ".pagination a", function (e) {

        e.preventDefault();

        $("#dashboardContent").load(
            $(this).attr("href")
        );

    });


    // ==========================================
    // RESET FILTER
    // ==========================================

    $(document).off("click", "#resetCategoryFilter");

    $(document).on("click", "#resetCategoryFilter", function () {

        $("#dashboardContent").load(
            "/Category/PartialIndex"
        );

    });


    // ==========================================
    // ADD CATEGORY
    // ==========================================

    $(document).off("submit", "#createCategoryForm");

    $(document).on("submit", "#createCategoryForm", function (e) {

        e.preventDefault();

        var form = $(this);

        $.ajax({

            url: form.attr("action"),

            type: "POST",

            data: form.serialize(),

            success: function (response) {

                if (response.success) {

                    var modalElement =
                        document.getElementById("createCategoryModal");

                    var modal =
                        bootstrap.Modal.getInstance(modalElement);

                    if (modal) {
                        modal.hide();
                    }

                    form[0].reset();

                    $("#dashboardContent").load(
                        "/Category/PartialIndex"
                    );

                }
                else {

                    alert(response.message);

                }

            },

            error: function (xhr) {

                console.log(xhr.responseText);

                alert(
                    "Something went wrong while adding the category."
                );

            }

        });

    });


    // ==========================================
    // EDIT CATEGORY
    // ==========================================

    $(document).off("submit", "#editCategoryForm");

    $(document).on("submit", "#editCategoryForm", function (e) {

        e.preventDefault();

        var form = $(this);

        $.ajax({

            url: form.attr("action"),

            type: "POST",

            data: form.serialize(),

            success: function (response) {

                if (response.success) {

                    var modalElement =
                        document.getElementById("editCategoryModal");

                    var modal =
                        bootstrap.Modal.getInstance(modalElement);

                    if (modal) {
                        modal.hide();
                    }

                    $("#dashboardContent").load(
                        "/Category/PartialIndex"
                    );

                }
                else {

                    alert(response.message);

                }

            },
            error: function (xhr) {
                console.log(xhr.responseText);
                alert(
                    "Something went wrong while updating the category."
                );
            }
        });
    });


    // ==========================================
    // DELETE CATEGORY
    // ==========================================

    $(document).off("submit", ".deleteCategoryForm");
    $(document).on("submit", ".deleteCategoryForm", function (e) {
        e.preventDefault();
        var form = $(this);
        if (!confirm("Delete this category?")) {
            return;
        }
        $.ajax({

            url: form.attr("action"),
            type: "POST",
            data: form.serialize(),
            success: function (response) {

                if (response.success) {

                    $("#dashboardContent").load(
                        "/Category/PartialIndex"
                    );
                }
                else {
                    alert(response.message);
                }
            },

            error: function (xhr) {
                console.log(xhr.responseText);
                alert(
                    "Something went wrong while deleting the category."
                );
            }
        });
    });


    // ==========================================
    // AUTO HIDE SUCCESS MESSAGE
    // ==========================================

    setTimeout(function () {
        $(".categorySuccessMessage").fadeOut(600);
    }, 3000);
</script>